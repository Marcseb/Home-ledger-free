{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development APP_VARIANT=accelerated-test && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:platform-paths": "node --experimental-strip-types scripts/test-platform-paths.mjs",
    "test:review-demo": "pnpm run build && node --experimental-strip-types scripts/test-review-demo.mjs",
    "test:server-discovery": "pnpm run build && node scripts/test-server-discovery.mjs",
    "test:demo-reset-security": "pnpm run build && node ./scripts/test-demo-reset-security.mjs",
    "test:household-reinitialization": "pnpm run build && node ./scripts/test-household-reinitialization.mjs",
    "test:household-invitations": "pnpm run build && node ./scripts/test-household-invitations.mjs",
    "test:shared-expense-shares": "node --experimental-strip-types ./scripts/test-shared-expense-shares.mjs",
    "test:shared-expense-payments": "node --experimental-strip-types ./scripts/test-shared-expense-payments.mjs",
    "test:personal-privacy": "pnpm run build && node ./scripts/test-personal-privacy.mjs",
    "test:recurring-transfers": "node --experimental-strip-types ./scripts/test-recurring-transfers.mjs",
    "test:goal-contribution-cancellation": "pnpm run build && node ./scripts/test-goal-contribution-cancellation.mjs",
    "test:recurring-calendar-date": "node --experimental-strip-types ./scripts/test-recurring-calendar-date.mjs",
    "test:current-balance-dates": "node --experimental-strip-types ./scripts/test-current-balance-dates.mjs",
    "backup:enroll": "node --experimental-strip-types ./scripts/backup-enroll.mjs",
    "backup:restore": "node --experimental-strip-types ./scripts/backup-restore.mjs",
    "invite-master": "node --experimental-strip-types ./scripts/invite-master.mjs",
    "test:recovery": "pnpm run build && node --experimental-strip-types ./scripts/test-recovery.mjs",
    "qa:activity": "node ./scripts/qa-activity-corrections.mjs",
    "qa:savings-accounts": "node ./scripts/qa-savings-accounts.mjs",
    "qa:goal-accounts": "node ./scripts/qa-goal-accounts.mjs",
    "qa:budgets": "pnpm run build && node --experimental-strip-types ./scripts/qa-budgets.mjs",
    "qa:test-clock": "pnpm run build && node --experimental-strip-types ./scripts/qa-test-clock.mjs"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
