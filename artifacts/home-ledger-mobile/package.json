{
  "name": "@workspace/home-ledger-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "env -u EXPO_TOKEN sh -c 'node scripts/configure-app-variant.js free && if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi; APP_VARIANT=free EXPO_PUBLIC_APP_VARIANT=free EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT'",
    "build": "node scripts/build.js",
    "build:apk:free": "node scripts/configure-app-variant.js free && APP_VARIANT=free EXPO_PUBLIC_APP_VARIANT=free pnpm dlx eas-cli@latest build --platform android --profile free-internal --non-interactive",
    "build:aab:free": "node scripts/configure-app-variant.js free && APP_VARIANT=free EXPO_PUBLIC_APP_VARIANT=free pnpm dlx eas-cli@latest build --platform android --profile play-store --non-interactive",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:network-backup": "node --experimental-strip-types scripts/test-network-backup.mjs",
    "test:shared-payments": "node --experimental-strip-types scripts/test-shared-payments.mjs",
    "test:bank-estimate": "node --experimental-strip-types --test lib/personal-bank-estimate.test.mjs",
    "test:server-discovery": "tsx scripts/test-server-discovery.mjs",
    "test:app-lock": "node --experimental-strip-types --test lib/app-lock-policy.test.mjs",
    "test:offline-sync": "tsx --test lib/storage-queue.test.mjs lib/household-storage.test.mjs lib/session-storage.test.mjs lib/sync-state.test.mjs lib/help-content.test.mjs lib/free-offline-edition.test.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@ungap/structured-clone": "^1.3.0",
    "@workspace/api-client-react": "workspace:*",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "create-launch": "0.3.6",
    "expo": "~57.0.25",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "zod": "catalog:",
    "zod-validation-error": "^3.4.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "expo-local-authentication": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo": "~57.0.25",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
