{
  "expo": {
    "name": "Home Ledger Free",
    "slug": "home-ledger-free",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "home-ledger-free",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Home Ledger connects only to the budget server you run on your local network.",
        "NSBonjourServices": [
          "_homeledger._tcp",
          "_http._tcp"
        ]
      }
    },
    "android": {
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ],
      "package": "app.homeledger.free",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "extra": {
      "appVariant": "free",
      "eas": {
        "projectId": "31cf2307-06e3-42bb-8d7c-9a271b5a08db"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Home Ledger uses Face ID to unlock the app."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F0E5"
        }
      ],
      "./plugins/withAndroidCleartext"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
